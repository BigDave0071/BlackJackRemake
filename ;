#include <stdlib.h>
#include <stdio.h>
#include <time.h>
#include "cards.h"



static struct Card *shoe;
static int shoe_size = 0;
static int decks;


/* private */




/* public */

void card_set_decks(int decks_amount) {
  decks = decks_amount;
}

void card_make_shoe(void) {
  free(shoe);
  shoe = (struct Card *)malloc(sizeof(struct Card) * 52 * decks);
  if(shoe == NULL) {
    printf("Error (card_make_shoe): memory allocation for shoe failed.\n");
    exit(1);
  }
  char suits[4] = {'C', 'D', 'H', 'S'};

  for(int deck = 0; deck < decks; deck++) {
    for(int suit = 0; suit < 4; suit++) {
      for(int value = 0; value < 13; value++) {
        int current_index = deck*52 + suit*13 + value;
        shoe[current_index].value = value + 1;
        shoe[current_index].suit = suits[suit];
        shoe_size++;
      }
    }
  }
}


// shuffles shoe seven times
void card_shuffle_shoe(void) {
  for(int i = 0; i < 7; i++) {
    for(int current_card = 0; current_card < shoe_size; current_card++) {
      srand(time(NULL) + i*52 + current_card);
      int new_position = rand() % shoe_size;
      struct Card temp = shoe[current_card];
      shoe[current_card] = shoe[new_position];
      shoe[new_position] = temp;
    }
  }
}


void reshuffle_shoe_if_low_cards(void) {
  // if less than 1/4 of cards left
  if(shoe_size < decks / 4) {
    card_make_shoe();
  }
}


struct Card card_draw_from_shoe(void) {
  struct Card drawn_card = {0, '0'};
  if(shoe_size > 0) {
    shoe_size--;
    drawn_card = shoe[shoe_size];
  } else {
    printf("Error (card_draw_from_shoe): cannot draw from empty shoe.\n");
  }
  return drawn_card;
}


int card_get_shoe_size(void) {
  return shoe_size;
}


int card_get_ivalue(struct Card card) {
  if(card.value > 9 && card.value < 14) {
    return 10;
  } else if(card.value > 0 && card.value < 10) {
    return card.value;
  } else {
    printf("Error (card_get_ivalue): invalid card as parameter.\n");
    return 0;
  }
}


int card_get_ivalue_total(struct Card *cards) {
  if(cards != NULL) {
    cards_length = sizeof(cards) / sizeof(cards[0]);
    return cards_length;
  } else {
    printf("Error (card_get_ivalue_total): empty cards (ptr) as parameter.\n")
    return 0;
  }
}

